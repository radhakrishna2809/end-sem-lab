!DOCTYPE html>
<html>
<head>
    <title>KLU College</title>
</head>
<body>

    <!-- Header -->
    <header>
        <h1>ABC College</h1>
        <p>Welcome to Our College</p>
    </header>

    <!-- Navigation -->
    <nav>
        <a href="#home">Home</a> |
        <a href="#courses">Courses</a> |
        <a href="#contact">Contact</a>
    </nav>

    <!-- Home Section -->
    <section id="home">
        <h2>Welcome to ABC College</h2>
        <p>Learn Today, Lead Tomorrow!</p>
        <button>Explore More</button>
    </section>

    <!-- Courses Section -->
    <section id="courses">
        <h2>Our Courses</h2>

        <table border="1">
            <tr>
                <th>Course</th>
                <th>Duration</th>
                <th>Fees</th>
            </tr>
            <tr>
                <td>B.Tech</td>
                <td>4 Years</td>
                <td>100000</td>
            </tr>
            <tr>
                <td>MBA</td>
                <td>2 Years</td>
                <td>80000</td>
            </tr>
            <tr>
                <td>BCA</td>
                <td>3 Years</td>
                <td>60000</td>
            </tr>
        </table>
    </section>

    <!-- Contact Form -->
    <section id="contact">
        <h2>Contact Us</h2>

        <form>
            <label>Name:</label>
            <input type="text" placeholder="Enter Your Name">
            <br><br>

            <label>Email:</label>
            <input type="email" placeholder="Enter Your Email">
            <br><br>

            <label>Message:</label>
            <textarea placeholder="Enter Your Message"></textarea>
            <br><br>

            <button type="submit">Submit</button>
        </form>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 KLU College. All Rights Reserved.</p>
        <p>Email: info@abccollege.com</p>
    </footer>

</body>
</html>